<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Lumia Ai</title>
<style>
:root{--bg:#f6f5fb;--sf:#ffffff;--tx:#1b1a24;--mu:#6b6980;--ac:#6c5ce7;--ac2:#00a99a;--bd:#e3e1ee;--code:#efedf8;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){color-scheme:dark;--bg:#13121a;--sf:#1d1c27;--tx:#ecebf5;--mu:#9a98b0;--ac:#8b7dff;--ac2:#2fd3c3;--bd:#2c2a3a;--code:#14131c}}
:root[data-theme="dark"]{color-scheme:dark;--bg:#13121a;--sf:#1d1c27;--tx:#ecebf5;--mu:#9a98b0;--ac:#8b7dff;--ac2:#2fd3c3;--bd:#2c2a3a;--code:#14131c}
*{box-sizing:border-box}
html,body{height:100%;margin:0}
body{background:var(--bg);color:var(--tx);font:16px/1.5 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;display:flex;flex-direction:column;max-width:760px;margin:0 auto}
header{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:12px 14px;border-bottom:1px solid var(--bd)}
.logo{font-weight:700;font-size:20px;letter-spacing:.2px}
.logo span{background:linear-gradient(90deg,var(--ac),var(--ac2));-webkit-background-clip:text;background-clip:text;color:transparent}
.sw{display:flex;background:var(--sf);border:1px solid var(--bd);border-radius:12px;padding:3px}
.sw button{border:0;background:none;color:var(--mu);font:inherit;font-size:14px;font-weight:600;padding:6px 12px;border-radius:9px;cursor:pointer}
.sw button.on{background:var(--ac);color:#fff}
#hint{padding:8px 14px;font-size:13px;color:var(--mu)}
#msgs{flex:1;overflow-y:auto;padding:8px 14px;display:flex;flex-direction:column;gap:10px}
.m{max-width:88%;padding:10px 13px;border-radius:16px;white-space:pre-wrap;word-wrap:break-word;overflow-wrap:anywhere}
.u{align-self:flex-end;background:var(--ac);color:#fff;border-bottom-right-radius:5px}
.a{align-self:flex-start;background:var(--sf);border:1px solid var(--bd);border-bottom-left-radius:5px}
.tag{display:block;font-size:11px;font-weight:700;color:var(--ac);margin-bottom:2px}
pre{background:var(--code);border-radius:10px;padding:10px;margin:6px 0;overflow-x:auto;font:13px/1.45 ui-monospace,Menlo,Consolas,monospace;white-space:pre}
.empty{margin:auto;text-align:center;color:var(--mu);padding:20px}
.empty b{display:block;font-size:22px;color:var(--tx);margin-bottom:6px}
form,.bar{display:flex;gap:8px;padding:10px 14px 12px;border-top:1px solid var(--bd)}
textarea{flex:1;resize:none;max-height:140px;border:1px solid var(--bd);background:var(--sf);color:var(--tx);border-radius:14px;padding:10px 12px;font:inherit}
textarea:focus{outline:2px solid var(--ac);outline-offset:0}
#go{border:0;background:var(--ac);color:#fff;font:inherit;font-weight:600;padding:0 18px;border-radius:14px;cursor:pointer}
#go:disabled{opacity:.5;cursor:default}
</style>
</head>
<body>
<header>
  <div class="logo"><span>Lumia Ai</span></div>
  <div class="sw" role="tablist">
    <button id="b-deep" class="on" type="button">Deep 1</button>
    <button id="b-heroes" type="button">Heroes 1</button>
  </div>
</header>
<div id="hint"></div>
<div id="msgs"></div>
<div class="bar">
  <textarea id="in" rows="1" placeholder="Напиши, что нужно…"></textarea>
  <button id="go" type="button">Отправить</button>
</div>
<script>
const MODELS = {
  deep:   {name:"Deep 1",   tier:"complex", hint:"Deep 1 — глубокие размышления, код и игры",
           rules:"Ты Lumia Ai, модель Deep 1. Думай глубоко и по шагам. Для кода давай полный рабочий код в блоках ```. Отвечай ясно и по делу, на языке пользователя."},
  heroes: {name:"Heroes 1", tier:"quick",   hint:"Heroes 1 — быстрые короткие ответы",
           rules:"Ты Lumia Ai, модель Heroes 1. Отвечай быстро, коротко и понятно, на языке пользователя."}
};
let cur = "deep", busy = false, history = [];
const $ = id => document.getElementById(id);
const msgs = $("msgs"), input = $("in"), go = $("go");

function setModel(k){
  cur = k;
  $("b-deep").classList.toggle("on", k==="deep");
  $("b-heroes").classList.toggle("on", k==="heroes");
  $("hint").textContent = MODELS[k].hint;
}
$("b-deep").onclick = () => setModel("deep");
$("b-heroes").onclick = () => setModel("heroes");
setModel("deep");

function empty(){
  msgs.innerHTML = "";
  const d = document.createElement("div");
  d.className = "empty";
  const b = document.createElement("b"); b.textContent = "Lumia Ai";
  d.append(b, "Выбери модель сверху и задай вопрос");
  msgs.append(d);
}
empty();

function fill(el, text){
  el.textContent = "";
  text.split("```").forEach((part, i) => {
    if(i % 2){
      const pre = document.createElement("pre");
      pre.textContent = part.replace(/^[^\n]*\n/, "").replace(/\n$/, "");
      el.append(pre);
    } else if(part){
      el.append(document.createTextNode(part));
    }
  });
}
function bubble(cls, text, tag){
  if(msgs.querySelector(".empty")) msgs.innerHTML = "";
  const el = document.createElement("div");
  el.className = "m " + cls;
  if(tag){ const t = document.createElement("span"); t.className = "tag"; t.textContent = tag; el.append(t); }
  const body = document.createElement("div");
  fill(body, text);
  el.append(body);
  msgs.append(el);
  msgs.scrollTop = msgs.scrollHeight;
  return body;
}

async function askAI(modelKey, msgsForApi){
  const r = await fetch("/api/chat", {
    method: "POST",
    headers: {"Content-Type": "application/json"},
    body: JSON.stringify({model: modelKey, messages: msgsForApi})
  });
  const d = await r.json().catch(() => ({}));
  if(!r.ok) throw {code: r.status === 429 ? "rate_limited" : "error", message: d.error};
  return d.text;
}

async function send(){
  const text = input.value.trim();
  if(!text || busy) return;
  busy = true; go.disabled = true; input.value = "";
  history.push({role:"user", content:text});
  bubble("u", text);
  const body = bubble("a", "Думаю…", MODELS[cur].name);
  try{
    const out = await askAI(cur, history);
    fill(body, out);
    history.push({role:"assistant", content:out});
  }catch(e){
    history.pop();
    fill(body, e && e.code === "rate_limited" ? "Слишком много запросов, подожди немного." : "Не получилось ответить. Попробуй ещё раз.");
  }
  busy = false; go.disabled = false; input.focus();
}
go.onclick = send;
input.addEventListener("keydown", e => { if(e.key === "Enter" && !e.shiftKey){ e.preventDefault(); send(); } });
input.addEventListener("input", () => { input.style.height = "auto"; input.style.height = Math.min(input.scrollHeight, 140) + "px"; });

</script>
</body>
</html>
